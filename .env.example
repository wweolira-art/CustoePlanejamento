# Porta da API em dev (8788 evita conflito com OpenIP em 127.0.0.1:8787)
PLANEJAMENTO_API_PORT=8789
# agricola = colheita/indicadores | custo = orçamento e cadastros
VITE_APP_FLAVOR=custo

ORACLE_USER=
ORACLE_PASSWORD=
# Consultas (SELECT). Se vazio, as leituras usam ORACLE_USER.
ORACLE_USER_CONSULTA=
ORACLE_PASSWORD_CONSULTA=
ORACLE_CONNECT_STRING=host:1521/servico
ORACLE_CLIENT_LIB_DIR=C:\instantclient-basic-windows.x64-23.26.1.0.0\instantclient_23_0

# URLs ORDS para importação de entrada de cana (opcional — há valores padrão)
ORDS_ENTRADA_CANA_MAQUINA_URL=
ORDS_ENTRADA_CANA_CAMINHAO_URL=
ORDS_HORAS_MAQUINA_URL=
ORDS_FAZENDA_USINA_URL=
ORDS_COLHEITA_DIARIA_URL=https://seu-host/ords/admin/colheitadiaria/
ORDS_PARADA_COLHEITA_URL=https://seu-host/ords/admin/paradacolheita/

# Login — API ORDS de usuários (senha validada com SHA-256 no servidor)
ORDS_BASE_URL=https://seu-host/ords/admin
# ORDS_USUARIO_URL=https://.../ords/admin/usuario/
# AUTH_SECRET=defina-um-segredo-forte-em-producao

# OpenIP (OpenIP/server.mjs) usa 127.0.0.1:8787 — não altere para 8787 se o OpenIP estiver ativo.
