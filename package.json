{
  "name": "custo-planejamento",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "start": "tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/*.test.ts",
    "desktop:install": "powershell -ExecutionPolicy Bypass -File scripts/windows/install-servico.ps1",
    "desktop:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/windows/uninstall-servico.ps1",
    "download:login-cane-stock": "node scripts/download-login-cane-stock.mjs",
    "build:login-cane-video": "node scripts/build-login-cane-stock-video.mjs",
    "generate:login-cane-video": "npm run download:login-cane-stock && npm run build:login-cane-video"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "better-sqlite3": "^12.2.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "oracledb": "^7.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.4"
  }
}
